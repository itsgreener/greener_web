mail	300	IN	A	82.98.169.92
autoconfig	300	IN	A	82.98.145.51
autodiscover	300	IN	A	82.98.145.60
ftp	300	IN	A	82.98.169.92
mysql	300	IN	A	82.98.169.92
@	300	IN	MX	10	mail.tr.itsgreener.com.
@	300	IN	SPF	"v=spf1 a mx ~all"
