# Copia este fichero a .env.local y rellena los valores reales.
# Nombres y validación exactos en src/lib/env.ts (Supabase, URL del sitio,
# firma, analítica: si falta o es inválida alguna, la app no arranca) y en
# src/lib/serverEnv.ts (una integración cada una: Cloudinary, Cloudmersive,
# contacto, hash de IP, Mailchimp). Si falla una de estas, solo falla su
# función; al arrancar el servidor, el log dice cuáles están mal.

# --- Supabase (arquitectura §5, §15.2, §17.1) ----------------------------
# URL del proyecto. Pública: se usa en el navegador.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sustituye a la "anon key" legacy). Segura de exponer
# en el navegador: solo concede lo que permitan las políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret key (sustituye a "service_role key" legacy). NUNCA debe llegar
# al navegador ni a ningún NEXT_PUBLIC_*. Solo en Server Actions / route
# handlers de confianza (feed_session/feed_round, contact_submission...).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Secreto propio (32+ caracteres) para firmar el cursor del feed y los links
# de preview. Técnicamente opcional (sin él se firma con SUPABASE_SECRET_KEY),
# pero en producción conviene definirlo: si no, el build/arranque avisa.
# Genera uno con:  openssl rand -base64 48
#   (o sin openssl: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
# Pégalo sin comillas y sin espacios. Con menos de 32 caracteres la validación
# de env falla. Al cambiarlo se invalidan los cursores del feed (24 h) y los
# links de preview (7 días) ya emitidos; nada más.
APP_SIGNING_SECRET=abcdefghijklmnopqrstuvwxyz1234567890ABCD

# --- Cloudinary (arquitectura §5, §9.2) ----------------------------------
# Cloud name: público, se usa para construir URLs de transformación en cliente.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# API key/secret: solo se usan en servidor para firmar subidas (signed
# upload) desde el ABM. El secret nunca llega al navegador (§9.2).
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- Escaneo antivirus (arquitectura §12.5) --------------------------------
# API key de Cloudmersive (https://cloudmersive.com) para escanear cada ZIP
# de tool/insight antes de publicarlo en Storage. El escaneo es bloqueante:
# si el servicio no responde o el resultado no es limpio, la subida se
# rechaza — ver cloudmersiveVirusScan.ts.
CLOUDMERSIVE_API_KEY=your-cloudmersive-api-key

# --- Formulario de contacto (brief §5.6, arquitectura §14.1) ---------------
# SMTP al que nodemailer envía el email (la newsletter va aparte, abajo).
CONTACT_SMTP_HOST=smtp.your-provider.com
CONTACT_SMTP_PORT=587
# 'true' para conexión TLS directa (puerto 465 típicamente), 'false'
# para STARTTLS (puerto 587 típicamente) — como texto, no booleano.
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=your-smtp-user
CONTACT_SMTP_PASSWORD=your-smtp-password

# Dirección de Greener que recibe los mensajes del formulario.
CONTACT_EMAIL_TO=hello@itsgreener.com

# Remitente con el que sale el email — normalmente el mismo buzón que
# CONTACT_SMTP_USER, o una dirección no-reply del mismo dominio.
CONTACT_EMAIL_FROM=no-reply@itsgreener.com

# Sal para el hash de la IP al aplicar el límite de envíos por IP.
# OBLIGATORIA EN PRODUCCIÓN (16+ caracteres, propia: no se admite la de
# desarrollo ni la de este ejemplo); sin ella el contacto y la newsletter
# fallan. En desarrollo y tests hay una por defecto en el código.
# Genera una con: openssl rand -base64 32
CONTACT_IP_HASH_SALT=fija-una-sal-propia-para-produccion

# --- Site -----------------------------------------------------------------
# Origen público del sitio. Se usa para construir URLs absolutas (OG,
# sitemap, redirectTo de OAuth, etc.). En producción: https://itsgreener.com
# (o el dominio final que se confirme). Opcional — por defecto localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_PLAUSIBLE_DOMAIN=itsgreener.com

# --- Newsletter (Mailchimp Marketing API, double opt-in) --------------------
# Solo de servidor: nunca con prefijo NEXT_PUBLIC_. Son OBLIGATORIAS: sin
# ellas la app no arranca (src/lib/env.ts).
# API key de Mailchimp (Account > Extras > API keys). Termina en -usXX.
MAILCHIMP_API_KEY=your-mailchimp-api-key-us21
# ID del Audience (Audience > Settings > Audience name and defaults).
MAILCHIMP_AUDIENCE_ID=your-audience-id
# Centro de datos: el sufijo de la API key (us21, us6...).
MAILCHIMP_SERVER_PREFIX=us21
