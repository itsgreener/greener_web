# --- Supabase (arquitectura §5, §15.2, §17.1) ---------------------------
# URL del proyecto. Pública: se usa en el navegador.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sustituye a la "anon key" legacy). Segura de exponer
# en el navegador: solo concede lo que permitan las políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret key (sustituye a "service_role key" legacy). NUNCA debe llegar
# al navegador ni a ningún NEXT_PUBLIC_*. Solo en Server Actions / route
# handlers de confianza (p.ej. el futuro /api/feed/sessions, §16.1).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Cloudinary (arquitectura §5, §9.2) ----------------------------------
# Cloud name: público, se usa para construir URLs de transformación en cliente.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# API key/secret: solo se usan en servidor para firmar subidas (signed
# upload) desde el ABM. El secret nunca llega al navegador (§9.2).
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- Admin / ABM (arquitectura §15.2) ------------------------------------
# Dominio de correo admitido en el ABM cuando la tabla admin_allowed_domain
# aún no tiene filas (p.ej. en un entorno nuevo recién desplegado). La
# restricción real y vinculante siempre es is_admin() en Postgres, no esta
# variable — esto es solo un valor de arranque/fallback.
ADMIN_ALLOWED_DOMAIN_FALLBACK=itsgreener.com

# --- Site -----------------------------------------------------------------
# Origen público del sitio. Se usa para construir URLs absolutas (OG,
# sitemap, redirectTo de OAuth, etc.). En producción: https://itsgreener.com
# (o el dominio final que se confirme).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
